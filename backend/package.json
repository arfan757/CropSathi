{
  "name": "cropsathi",
  "version": "1.0.0",
  "description": "Early Crop Disease Detection System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedCatalogs.js",
    "cron:test-weather": "node -e \"import('./src/cron/pollWeather.js').then(m => m.pollWeatherForActiveFarms()).then(console.log)\"",
    "cron:test-satellite": "node -e \"import('./src/cron/pollSatellite.js').then(m => m.pollSatelliteForActiveFarms()).then(console.log)\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "form-data": "^4.0.0",
    "geotiff": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^8.24.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.4"
  }
}
