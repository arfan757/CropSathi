# ==============================================================================
# CropSathi Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in this directory:
#   cp .env.example .env
# ==============================================================================

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cropsathi?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRE=30d

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://cropsathi.vercel.app

GEMINI_API_KEY=your_google_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

ML_SERVICE_URL=http://127.0.0.1:10000

CRON_SECRET=your_internal_cron_trigger_secret
CRON_BATCH_SIZE=200
RETRAIN_THRESHOLD=500
