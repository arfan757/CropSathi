# ==============================================================================
# CropSathi Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your backend directory or deploy environment:
#   cp .env.example backend/.env
# NOTE: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL - Recommended)
# Get your project URL and service_role secret from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional Legacy MongoDB fallback:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cropsathi?retryWrites=true&w=majority

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRE=30d

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. your local dev URL or Vercel production domain)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://cropsathi.vercel.app

# AI & LLM Vision Services
# Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key

# OpenRouter / Minimax fallback API key (optional fallback for structured reasoning)
OPENROUTER_API_KEY=your_openrouter_api_key

# Satellite Data Ingestion (Copernicus Data Space Ecosystem)
# Register at dataspace.copernicus.eu -> generate OAuth client credentials
# Used for real Sentinel-2 optical reflectance (NDVI/NDRE) and Landsat 8/9 thermal (LST/CWSI)
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# Machine Learning Service (FastAPI CNN classifier for PlantVillage 38 classes)
# In local development: http://127.0.0.1:10000
# In Render production: https://cropsathi-ml.onrender.com or internal service URL
ML_SERVICE_URL=http://127.0.0.1:10000

# Background Cron & Pipeline Configuration
CRON_SECRET=your_internal_cron_trigger_secret
CRON_BATCH_SIZE=200
RETRAIN_THRESHOLD=500
