# ==============================================================================
# CropSathi Global .gitignore
# ==============================================================================

# Environment & Secret files
.env
.env.*
!.env.example
*.local

# Dependency directories
node_modules/
backend/node_modules/

# Python & Machine Learning artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
ml-service/.venv/
ml-service/__pycache__/
ml-service/trained_plant_disease_model.keras

# Uploads & Ephemeral storage
# (Leaves repository clean; uploads are local/ephemeral on server)
backend/uploads/cases/*
!backend/uploads/cases/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
*.swp

# IDE & Editor caches
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.freebuff
.agents
